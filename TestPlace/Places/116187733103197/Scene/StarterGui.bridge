StarterGui "StarterGui" {
    ScreenGui "ObbyHud" ResetOnSpawn=false IgnoreGuiInset {
        Frame "Panel" Size=0,260,0,86 Position=0,16,0,16 BackgroundColor3=#FFFFFF BackgroundTransparency=0.15 BorderSizePixel=0 {
            UICorner "Corner" CornerRadius=0,12
            UIStroke "Border" Color=#E5E5E5 Thickness=1
            TextLabel "Title" Size=1,0,0,22 Position=0,12,0,8 BackgroundTransparency=1 Text="OBBY" TextColor3=#0D0D0D TextXAlignment=Left Font=Bold TextSize=16
            TextLabel "Timer" Size=1,0,0,26 Position=0,12,0,32 BackgroundTransparency=1 Text="00:00.00" TextColor3=#4D6BFE TextXAlignment=Left Font=GothamBold TextSize=20
            TextLabel "Section" Size=1,0,0,20 Position=0,12,0,60 BackgroundTransparency=1 Text="Секция 1 / 9" TextColor3=#6B7280 TextXAlignment=Left TextSize=14
        }
        LocalScript "HudController" @src="Scripts/StarterGui/ObbyHud/HudController.lua"
    }
}
