	    Model "Coin Rush" $Coins=25 $Duration=30 {
      Part "Arena Floor" Anchored CFrame=150,0.5,0 Color=#2F3B2F Material=Slate Size=60,1,60
      Part "Wall N" Anchored CFrame=150,7,-30.5 Color=#8FB8FF Material=Glass Size=62,12,1 Transparency=0.6
      Part "Wall S" Anchored CFrame=150,7,30.5 Color=#8FB8FF Material=Glass Size=62,12,1 Transparency=0.6
      Part "Wall E" Anchored CFrame=180.5,7,0 Color=#8FB8FF Material=Glass Size=1,12,60 Transparency=0.6
      Part "Wall W" Anchored CFrame=119.5,7,0 Color=#8FB8FF Material=Glass Size=1,12,60 Transparency=0.6
      Part "Pillar NE" Anchored CFrame=178,7,-28 Color=#5A4A3A Material=Brick Size=2,12,2
      Part "Pillar NW" Anchored CFrame=122,7,-28 Color=#5A4A3A Material=Brick Size=2,12,2
      Part "Pillar SE" Anchored CFrame=178,7,28 Color=#5A4A3A Material=Brick Size=2,12,2
      Part "Pillar SW" Anchored CFrame=122,7,28 Color=#5A4A3A Material=Brick Size=2,12,2
      Part "Lamp NE" Anchored CFrame=178,14.2,-28 Color=#FFD27F Material=Neon Shape=Ball Size=2.4,2.4,2.4 {
        PointLight "Light" Brightness=3 Color=#FFD27F Range=28
      }
      Part "Lamp NW" Anchored CFrame=122,14.2,-28 Color=#FFD27F Material=Neon Shape=Ball Size=2.4,2.4,2.4 {
        PointLight "Light" Brightness=3 Color=#FFD27F Range=28
      }
      Part "Lamp SE" Anchored CFrame=178,14.2,28 Color=#FFD27F Material=Neon Shape=Ball Size=2.4,2.4,2.4 {
        PointLight "Light" Brightness=3 Color=#FFD27F Range=28
      }
      Part "Lamp SW" Anchored CFrame=122,14.2,28 Color=#FFD27F Material=Neon Shape=Ball Size=2.4,2.4,2.4 {
        PointLight "Light" Brightness=3 Color=#FFD27F Range=28
      }
      Part "Start Pad" Anchored CFrame=108,0.5,0|0,0,90 Color=#2ECC71 Material=Neon Shape=Cylinder Size=1,9,9 {
        ProximityPrompt "Prompt" ActionText="Старт" HoldDuration=0.4 MaxActivationDistance=10 ObjectText="Coin Rush"
      }
      Part "Board" Anchored CFrame=108,4,-12|0,180,0 Color=#14142B Size=16,8,1 {
        SurfaceGui "Gui" {
          TextLabel "Text" BackgroundTransparency=1 Size=1,0,1,0 Text="COIN RUSH\nВстань на зелёную площадку и нажми E" TextColor3=#FFE066 TextScaled
        }
      }
      Script "Hello" @code="print(\"[Coin Rush] зона загружена\")"
      Script "Game" @code=<<<
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")

        local Zone = script.Parent
        local Floor = Zone:WaitForChild("Arena Floor")
        local Pad = Zone:WaitForChild("Start Pad")
        local Prompt = Pad:WaitForChild("Prompt")
        local Label = Zone:WaitForChild("Board"):WaitForChild("Gui"):WaitForChild("Text")

        local Duration = Zone:GetAttribute("Duration") or 30
        local CoinCount = Zone:GetAttribute("Coins") or 25
        local GoldChance = 0.15

        local Green = Color3.fromRGB(46, 204, 113)
        local Red = Color3.fromRGB(231, 76, 60)
        local Silver = Color3.fromRGB(190, 215, 255)
        local Gold = Color3.fromRGB(255, 200, 30)

        local CoinsFolder = Instance.new("Folder")
        CoinsFolder.Name = "Coins"
        CoinsFolder.Parent = Zone

        local Running, Current, Score, EndTime = false, nil, 0, 0
        local Coins = {}
        local Best, BestName = 0, ""
        local Finish

        local function SetBoard(Text)
          Label.Text = Text
        end

        local function IdleBoard()
          local Record = "Рекорда пока нет"
          if Best > 0 then Record = string.format("Рекорд: %s — %d", BestName, Best) end
          SetBoard("COIN RUSH\nВстань на зелёную площадку и нажми E\n" .. Record)
        end

        local function RandomSpot()
          local Half = Floor.Size * 0.5
          local X = (math.random() * 2 - 1) * (Half.X - 4)
          local Z = (math.random() * 2 - 1) * (Half.Z - 4)
          local Top = Floor.Position.Y + Half.Y
          return Vector3.new(Floor.Position.X + X, Top + 2.5, Floor.Position.Z + Z)
        end

        local function AddCoin()
          local Big = math.random() < GoldChance
          local Part = Instance.new("Part")
          Part.Name = Big and "Gold Coin" or "Coin"
          Part.Shape = Enum.PartType.Cylinder
          Part.Size = Big and Vector3.new(0.4, 3.5, 3.5) or Vector3.new(0.3, 2.5, 2.5)
          Part.Color = Big and Gold or Silver
          Part.Material = Enum.Material.Neon
          Part.Anchored = true
          Part.CanCollide = false
          Part.CanTouch = false
          Part.Parent = CoinsFolder
          table.insert(Coins, { Part = Part, Pos = RandomSpot(), Phase = math.random() * 6.28, Value = Big and 5 or 1 })
        end

        RunService.Heartbeat:Connect(function()
          if not Running then return end
          local Char = Current and Current.Character
          local Root = Char and Char:FindFirstChild("HumanoidRootPart")
          local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
          if not Root or not Hum or Hum.Health <= 0 then
            Finish()
            return
          end
          local T = os.clock()
          for I = #Coins, 1, -1 do
            local C = Coins[I]
            local P = C.Pos + Vector3.new(0, math.sin(T * 3 + C.Phase) * 0.4, 0)
            C.Part.CFrame = CFrame.new(P) * CFrame.Angles(0, T * 2 + C.Phase, 0)
            if (Root.Position - P).Magnitude < 4 then
              Score += C.Value
              C.Part:Destroy()
              table.remove(Coins, I)
              AddCoin()
            end
          end
        end)

        Finish = function()
          if not Running then return end
          Running = false
          for _, C in ipairs(Coins) do C.Part:Destroy() end
          table.clear(Coins)

          local Plr = Current
          Current = nil
          local Name = Plr and Plr.Name or "?"
          local IsRecord = Score > Best
          if IsRecord then Best, BestName = Score, Name end
          SetBoard(string.format("Игра окончена!\n%s: %d очков%s\nРекорд: %s — %d",
            Name, Score, IsRecord and " — НОВЫЙ РЕКОРД!" or "", BestName == "" and "—" or BestName, Best))

          local Char = Plr and Plr.Character
          local Root = Char and Char:FindFirstChild("HumanoidRootPart")
          if Root then Root.CFrame = CFrame.new(Pad.Position + Vector3.new(0, 4, 8)) end

          task.delay(4, function()
            if Running then return end
            Prompt.Enabled = true
            Pad.Color = Green
            IdleBoard()
          end)
        end

        local function StartRound(Plr)
          if Running then return end
          local Char = Plr.Character
          local Root = Char and Char:FindFirstChild("HumanoidRootPart")
          if not Root then return end

          Running, Current, Score = true, Plr, 0
          EndTime = os.clock() + Duration
          Prompt.Enabled = false
          Pad.Color = Red
          for _ = 1, CoinCount do AddCoin() end
          Root.CFrame = CFrame.new(Floor.Position + Vector3.new(0, 4, 0))

          task.spawn(function()
            while Running and Current == Plr do
              local TimeLeft = EndTime - os.clock()
              if TimeLeft <= 0 then break end
              SetBoard(string.format("%s\nВремя: %d\nОчки: %d", Plr.Name, math.ceil(TimeLeft), Score))
              task.wait(0.2)
            end
            if Running and Current == Plr then Finish() end
          end)
        end

        Prompt.Triggered:Connect(StartRound)
        Players.PlayerRemoving:Connect(function(Plr)
          if Plr == Current then Finish() end
        end)

        Pad.Color = Green
        IdleBoard()
      >>>
    }
}
