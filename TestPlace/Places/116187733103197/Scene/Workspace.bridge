Workspace "Workspace" AirDensity=0.001 Gravity=196.2 FallenPartsDestroyHeight=-500 StreamingEnabled=false {
    Part "Baseplate" Size=512,20,512 Anchored BottomSurface=Smooth CFrame=0,-10,0 Color=#F5F5F5 Locked TopSurface=Smooth Material=SmoothPlastic

    SpawnLocation "SpawnLocation" Size=8,1,8 Anchored BottomSurface=Smooth CFrame=0,1.5,0 Duration=0 Neutral TopSurface=Smooth Color=#4D6BFE Material=Neon {
        Decal "Decal" Face=Top TextureContent="rbxasset://textures/SpawnLocation.png"
    }

    Model "Obby" $Sections=9 {
        Model "S1 Start" {
            Part "Floor" Size=16,1,16 Anchored CFrame=0,0.5,-10 Color=#E8E8E8 Material=SmoothPlastic
            Part "Wall L" Size=1,4,16 Anchored CFrame=-8.5,2.5,-10 Color=#D0D0D0 Material=SmoothPlastic
            Part "Wall R" Size=1,4,16 Anchored CFrame=8.5,2.5,-10 Color=#D0D0D0 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-10 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Part "Sign" Size=4,2,0.2 Anchored CFrame=0,3,-17.5 Color=#4D6BFE Material=Neon {
                SurfaceGui "Gui" {
                    TextLabel "Label" Size=1,0,1,0 BackgroundTransparency=1 Text="S1 · START" TextColor3=#FFFFFF TextScaled
                }
            }
        }

        Model "S2 Kill Bricks" $StartZ=-40 $StepZ=8 $Steps=6 {
            Part "Island A" Size=10,1,10 Anchored CFrame=0,0.5,-25 Color=#E8E8E8 Material=SmoothPlastic
            Part "Kill A" Size=10,1,4 Anchored CFrame=0,0.5,-32 Color=#FF4B4B Material=Neon
            Part "Platform A" Size=6,1,3 Anchored CFrame=0,0.5,-37 Color=#E8E8E8 Material=SmoothPlastic
            Part "Kill B" Size=6,1,3 Anchored CFrame=0,0.5,-41 Color=#FF4B4B Material=Neon
            Part "Platform B" Size=6,1,3 Anchored CFrame=0,0.5,-45 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-49 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Part "Finish Pad" Size=10,1,6 Anchored CFrame=0,0.5,-49 Color=#E8E8E8 Material=SmoothPlastic
        }

        Model "S3 Moving Platforms" $SpanX=12 $Speed=0.35 $Count=4 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-60 Color=#E8E8E8 Material=SmoothPlastic
            Part "Mover 1" Size=4,1,4 Anchored CFrame=-6,1,-72 Color=#4D6BFE Material=Neon
            Part "Mover 2" Size=4,1,4 Anchored CFrame=6,1,-80 Color=#4D6BFE Material=Neon
            Part "Mover 3" Size=4,1,4 Anchored CFrame=-6,1,-88 Color=#4D6BFE Material=Neon
            Part "Finish Pad" Size=10,1,8 Anchored CFrame=0,0.5,-98 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-98 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Script "MoverController" @src="Scripts/Workspace/Obby/S3 Moving Platforms/MoverController.lua"
        }

        Model "S4 Rotating Discs" $SpeedDeg=45 $DiscCount=3 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-112 Color=#E8E8E8 Material=SmoothPlastic
            Model "Disc 1" {
                Part "Base" Size=1,1,1 Anchored CFrame=0,1,-125 Color=#4D6BFE Material=SmoothPlastic
                Part "Disc" Size=1,12,12 Anchored CFrame=0,1.5,-125 Color=#4D6BFE Material=Neon Shape=Cylinder
                Part "Wall" Size=1,2,12 Anchored CFrame=0,2.5,-125 Color=#D0D0D0 Material=SmoothPlastic
            }
            Model "Disc 2" {
                Part "Base" Size=1,1,1 Anchored CFrame=0,1,-138 Color=#4D6BFE Material=SmoothPlastic
                Part "Disc" Size=1,12,12 Anchored CFrame=0,1.5,-138 Color=#4D6BFE Material=Neon Shape=Cylinder
                Part "Wall" Size=1,2,12 Anchored CFrame=0,2.5,-138 Color=#D0D0D0 Material=SmoothPlastic
            }
            Part "Finish Pad" Size=10,1,10 Anchored CFrame=0,0.5,-152 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-152 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Script "SpinnerController" @src="Scripts/Workspace/Obby/S4 Rotating Discs/SpinnerController.lua"
        }

        Model "S5 Conveyors" $Speed=8 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-165 Color=#E8E8E8 Material=SmoothPlastic
            Part "Belt A" Size=6,1,16 Anchored CFrame=0,0.5,-178 Color=#E8E8E8 Material=SmoothPlastic
            Part "Belt B" Size=6,1,16 Anchored CFrame=0,0.5,-195 Color=#E8E8E8 Material=SmoothPlastic
            Part "Belt C" Size=6,1,16 Anchored CFrame=0,0.5,-212 Color=#E8E8E8 Material=SmoothPlastic
            Part "Finish Pad" Size=10,1,8 Anchored CFrame=0,0.5,-228 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-228 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Script "ConveyorController" @src="Scripts/Workspace/Obby/S5 Conveyors/ConveyorController.lua"
        }

        Model "S6 Slide" $TiltDeg=22 $LavaDepth=3 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-242 Color=#E8E8E8 Material=SmoothPlastic
            Part "Slide" Size=10,1,40 Anchored CFrame=0,-1,-268|22,0,0 Color=#4D6BFE Material=SmoothPlastic
            Part "Lava" Size=20,2,40 Anchored CFrame=0,-6,-268 Color=#FF4B4B Material=Neon
            Part "Finish Pad" Size=10,1,10 Anchored CFrame=0,-8,-292 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,-7.4,-292 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
        }

        Model "S7 Disappearing" $OnTime=1.2 $OffTime=0.8 $Offset=0.4 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-305 Color=#E8E8E8 Material=SmoothPlastic
            Part "Tile 1" Size=4,1,4 Anchored CFrame=0,1,-315 Color=#4D6BFE Material=Neon
            Part "Tile 2" Size=4,1,4 Anchored CFrame=0,1,-322 Color=#4D6BFE Material=Neon
            Part "Tile 3" Size=4,1,4 Anchored CFrame=0,1,-329 Color=#4D6BFE Material=Neon
            Part "Tile 4" Size=4,1,4 Anchored CFrame=0,1,-336 Color=#4D6BFE Material=Neon
            Part "Finish Pad" Size=10,1,10 Anchored CFrame=0,0.5,-348 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-348 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Script "TileController" @src="Scripts/Workspace/Obby/S7 Disappearing/TileController.lua"
        }

        Model "S8 Spinners" $SpeedDeg=90 $BeamCount=2 {
            Part "Start Pad" Size=8,1,8 Anchored CFrame=0,0.5,-362 Color=#E8E8E8 Material=SmoothPlastic
            Part "Base" Size=4,1,4 Anchored CFrame=0,0.5,-376 Color=#E8E8E8 Material=SmoothPlastic
            Part "Spinner Hub" Size=1,1,1 Anchored CFrame=0,1,-376 Color=#4D6BFE Material=Neon
            Part "Beam A" Size=12,1,1 Anchored CFrame=6,1,-376 Color=#FF4B4B Material=Neon
            Part "Beam B" Size=12,1,1 Anchored CFrame=-6,1,-376 Color=#FF4B4B Material=Neon
            Part "Finish Pad" Size=10,1,10 Anchored CFrame=0,0.5,-390 Color=#E8E8E8 Material=SmoothPlastic
            Part "Checkpoint" Size=6,0.2,6 Anchored CFrame=0,1.1,-390 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.4
            Script "SpinnerController" @src="Scripts/Workspace/Obby/S8 Spinners/SpinnerController.lua"
        }

        Model "S9 Finish" $Reward=500 {
            Part "Floor" Size=16,1,16 Anchored CFrame=0,0.5,-405 Color=#E8E8E8 Material=SmoothPlastic
            Part "Pedestal" Size=4,2,4 Anchored CFrame=0,2,-405 Color=#4D6BFE Material=Neon Shape=Cylinder
            Part "Finish Pad" Size=8,0.2,8 Anchored CFrame=0,1.1,-405 Color=#4D6BFE Material=Neon CanCollide=false Transparency=0.3
            Part "Banner" Size=10,2,0.2 Anchored CFrame=0,5,-412 Color=#4D6BFE Material=Neon {
                SurfaceGui "Gui" {
                    TextLabel "Label" Size=1,0,1,0 BackgroundTransparency=1 Text="FINISH" TextColor3=#FFFFFF TextScaled
                }
            }
        }
    }
	
	Part "Lamp Red"     $_prefab="Prefabs/Lamp.bridge" CFrame=20,0.25,0  $Color=#FF0000
	Part "Lamp Green"   $_prefab="Prefabs/Lamp.bridge" CFrame=20,0.25,10 $Color=#00FF00 $Brightness=6
	Part "Lamp Default" $_prefab="Prefabs/Lamp.bridge" CFrame=20,0.25,20
}
